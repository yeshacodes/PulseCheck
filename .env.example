# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase project settings -> API -> service_role secret.
# Server-only. Never expose this key to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Shared secret for the scheduled worker:
# Authorization: Bearer <CRON_SECRET>
# Generate with: openssl rand -hex 32
CRON_SECRET=your-long-random-cron-secret

# Public base URL of the app, without a trailing slash.
# Use http://localhost:3000 locally and your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
